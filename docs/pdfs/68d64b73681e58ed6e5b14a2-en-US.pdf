   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">1 Wash and dry all produce. Peel and finely chop garlic. Place rice in a fine-mesh sieve and rinse until water runs clear. Melt 1 TBSP butter (2 TBSP for 4 servings) in a medium pot over medium-high heat. Add garlic and cook until fragrant, 30 seconds to 1 minute. Stir in rice, 1 cup water (2 cups for 4), and a pinch of salt. Bring to a boil, then cover and reduce to a low simmer. Cook until rice is tender, 15 minutes. Keep covered off heat for at least 10 minutes, or until ready to serve.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>EP1364</rdf:li>
     <rdf:li>Lemon Oregano Chicken Bowls</rdf:li>
    </rdf:Bag>
